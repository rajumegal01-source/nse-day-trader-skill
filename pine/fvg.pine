//@version=5
// Fair Value Gap retest
// Generated by lab/pine.py from the Trading Lab (github.com/rajumegal01-source/nse-day-trader-skill).
// Input defaults: the lab's general defaults.
// Educational only, not investment advice. શૈક્ષણિક હેતુ માટે, રોકાણ સલાહ નથી.
// It draws levels and raises alerts. It places no orders. No setup here has a proven edge out of sample.
indicator("Lab Fair Value Gap retest", overlay=true, max_labels_count=200, max_boxes_count=100)

// ---- shared rules (same names as lab/core.py EXITS) ----
tz = "Asia/Kolkata"
deadHHMM = input.int(1130, "No new signals after (HHMM, IST)")
sideIn = input.string("both", "Sides", options=["long", "both"])
stopMode = input.string("natural", "Stop", options=["natural", "p0.5", "p1.0"])
tgtR = input.float(2.0, "Target in R (0 = exit at 15:15)", minval=0, step=0.5)
mins = hour(time, tz) * 60 + minute(time, tz)
deadMin = math.floor(deadHHMM / 100) * 60 + deadHHMM % 100
newDay = ta.change(time("D")) != 0
canSignal = mins <= deadMin and mins < 915
var bool doneToday = false
if newDay
    doneToday := false

// draws one setup label with entry / stop / target, the way lab/core.py stop_price() works
f_setup(bool isLong, float entry, float natStop, string name) =>
    float stp = stopMode == "p0.5" ? entry * (isLong ? 0.995 : 1.005) : stopMode == "p1.0" ? entry * (isLong ? 0.99 : 1.01) : natStop
    float tgt = tgtR > 0 ? entry + (isLong ? 1 : -1) * math.abs(entry - stp) * tgtR : na
    string txt = name + (isLong ? " long setup" : " short setup") + "\nentry " + str.tostring(entry, format.mintick) + "\nstop " + str.tostring(stp, format.mintick) + (na(tgt) ? "\ntarget: 15:15 exit" : "\ntarget " + str.tostring(tgt, format.mintick))
    label.new(bar_index, isLong ? low : high, txt, style=isLong ? label.style_label_up : label.style_label_down, color=isLong ? color.new(color.teal, 10) : color.new(color.maroon, 10), textcolor=color.white, size=size.small)

// ---- Fair Value Gap, first retest ----
// Bullish gap: this bar's low is above the high two bars back (same day). The setup is the first bar
// within `age` bars that trades into the gap and closes above its top. Stop = the gap's far edge.
// A close through the far edge kills the gap. Mirror for bearish gaps.
minPct = input.float(0.1, "Minimum gap size (%)", minval=0, step=0.05)
age = input.int(12, "Retest within (bars)", minval=1)
sameDay = not newDay and not newDay[1]
bullGap = sameDay and low > high[2] and (low - high[2]) / close * 100 >= minPct
bearGap = sameDay and high < low[2] and (low[2] - high) / close * 100 >= minPct
var float bTop = na
var float bBot = na
var int bBar = na
var float sTop = na
var float sBot = na
var int sBar = na
if newDay
    bBar := na
    sBar := na
if bullGap
    bTop := low
    bBot := high[2]
    bBar := bar_index
    box.new(bar_index - 2, low, bar_index + age, high[2], border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 85))
if bearGap
    sTop := low[2]
    sBot := high
    sBar := bar_index
    box.new(bar_index - 2, low[2], bar_index + age, high, border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 85))
bLive = not na(bBar) and bar_index > bBar and bar_index - bBar <= age
sLive = not na(sBar) and bar_index > sBar and bar_index - sBar <= age
if bLive and close < bBot
    bBar := na
    bLive := false
if sLive and close > sTop
    sBar := na
    sLive := false
longSig = bLive and canSignal and not doneToday and low <= bTop and close > bTop
shortSig = sLive and canSignal and not doneToday and sideIn == "both" and high >= sBot and close < sBot
if longSig
    f_setup(true, close, bBot, "FVG")
    doneToday := true
    bBar := na
else if shortSig
    f_setup(false, close, sTop, "FVG")
    doneToday := true
    sBar := na
alertcondition(longSig or shortSig, "FVG retest setup", "FVG rule output on the chart")

// ---- disclaimer on the chart ----
var table disc = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(disc, 0, 0, "Educational only, not investment advice", text_color=color.gray, text_size=size.small)
