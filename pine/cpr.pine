//@version=5
// Central Pivot Range
// Generated by lab/pine.py from the Trading Lab (github.com/rajumegal01-source/nse-day-trader-skill).
// Input defaults: the lab's general defaults.
// Educational only, not investment advice. શૈક્ષણિક હેતુ માટે, રોકાણ સલાહ નથી.
// It draws levels and raises alerts. It places no orders. No setup here has a proven edge out of sample.
indicator("Lab Central Pivot Range", overlay=true, max_labels_count=200, max_boxes_count=100)

// ---- shared rules (same names as lab/core.py EXITS) ----
tz = "Asia/Kolkata"
deadHHMM = input.int(1130, "No new signals after (HHMM, IST)")
sideIn = input.string("both", "Sides", options=["long", "both"])
stopMode = input.string("natural", "Stop", options=["natural", "p0.5", "p1.0"])
tgtR = input.float(2.0, "Target in R (0 = exit at 15:15)", minval=0, step=0.5)
mins = hour(time, tz) * 60 + minute(time, tz)
deadMin = math.floor(deadHHMM / 100) * 60 + deadHHMM % 100
newDay = ta.change(time("D")) != 0
canSignal = mins <= deadMin and mins < 915
var bool doneToday = false
if newDay
    doneToday := false

// draws one setup label with entry / stop / target, the way lab/core.py stop_price() works
f_setup(bool isLong, float entry, float natStop, string name) =>
    float stp = stopMode == "p0.5" ? entry * (isLong ? 0.995 : 1.005) : stopMode == "p1.0" ? entry * (isLong ? 0.99 : 1.01) : natStop
    float tgt = tgtR > 0 ? entry + (isLong ? 1 : -1) * math.abs(entry - stp) * tgtR : na
    string txt = name + (isLong ? " long setup" : " short setup") + "\nentry " + str.tostring(entry, format.mintick) + "\nstop " + str.tostring(stp, format.mintick) + (na(tgt) ? "\ntarget: 15:15 exit" : "\ntarget " + str.tostring(tgt, format.mintick))
    label.new(bar_index, isLong ? low : high, txt, style=isLong ? label.style_label_up : label.style_label_down, color=isLong ? color.new(color.teal, 10) : color.new(color.maroon, 10), textcolor=color.white, size=size.small)

// ---- Central Pivot Range (floor pivots of the previous day) ----
// P = (H + L + C) / 3, BC = (H + L) / 2, TC = 2P - BC, R1 = 2P - L, S1 = 2P - H.
// bounce: came from one side, wicked to the level, closed back on that side (stop = bar extreme).
// break:  previous close on one side, this close beyond the level by 0.05%.
levelsIn = input.string("all", "Levels", options=["P", "cpr", "rs", "all"])
modeIn = input.string("bounce", "Mode", options=["bounce", "break"])
ph_ = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pl_ = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
pc_ = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
P = (ph_ + pl_ + pc_) / 3
bc0 = (ph_ + pl_) / 2
tc0 = 2 * P - bc0
BC = math.min(bc0, tc0)
TC = math.max(bc0, tc0)
R1 = 2 * P - pl_
S1 = 2 * P - ph_
plot(P, "P", color.yellow, 2, plot.style_linebr)
plot(BC, "BC", color.new(color.yellow, 50), 1, plot.style_linebr)
plot(TC, "TC", color.new(color.yellow, 50), 1, plot.style_linebr)
plot(R1, "R1", color.red, 1, plot.style_linebr)
plot(S1, "S1", color.green, 1, plot.style_linebr)

// returns 1 (long), -1 (short) or 0 for one level on this bar
f_react(float lvl) =>
    float pc = close[1]
    int r = 0
    if not newDay
        if modeIn == "bounce"
            r := pc > lvl and low <= lvl and close > lvl ? 1 : pc < lvl and high >= lvl and close < lvl ? -1 : 0
        else
            r := pc <= lvl and close > lvl * 1.0005 ? 1 : pc >= lvl and close < lvl * 0.9995 ? -1 : 0
    r

// every level is checked on every bar (Pine wants functions with history called each bar)
rP = f_react(P)
rBC = f_react(BC)
rTC = f_react(TC)
rR1 = f_react(R1)
rS1 = f_react(S1)
sig = levelsIn == "P" ? rP : levelsIn == "cpr" ? (rBC != 0 ? rBC : rTC) : levelsIn == "rs" ? (rR1 != 0 ? rR1 : rS1) : rP != 0 ? rP : rBC != 0 ? rBC : rTC != 0 ? rTC : rR1 != 0 ? rR1 : rS1
longSig = sig == 1 and canSignal and not doneToday
shortSig = sig == -1 and canSignal and not doneToday and sideIn == "both"
if longSig
    f_setup(true, close, low, "CPR")
    doneToday := true
else if shortSig
    f_setup(false, close, high, "CPR")
    doneToday := true
alertcondition(longSig or shortSig, "CPR setup", "CPR rule output on the chart")

// ---- disclaimer on the chart ----
var table disc = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(disc, 0, 0, "Educational only, not investment advice", text_color=color.gray, text_size=size.small)
