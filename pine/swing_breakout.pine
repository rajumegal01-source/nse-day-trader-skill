//@version=5
// Swing breakout (daily)
// Generated by lab/pine.py from the Trading Lab (github.com/rajumegal01-source/nse-day-trader-skill).
// Input defaults: the lab's general defaults.
// Educational only, not investment advice. શૈક્ષણિક હેતુ માટે, રોકાણ સલાહ નથી.
// It draws levels and raises alerts. It places no orders. No setup here has a proven edge out of sample.
indicator("Lab Swing breakout (daily)", overlay=true, max_labels_count=200, max_boxes_count=100)

// ---- Swing breakout (DAILY chart), as in lab/swing.py ----
// Close above the highest high of the previous N days with volume >= V x its 20-day average.
// Levels: stop = close - S x ATR14, target = close + T x (close - stop), max hold in lab/swing.py.
n = input.int(20, "Breakout of N-day high", minval=2)
vmult = input.float(1.5, "Volume x 20-day average", minval=0, step=0.1)
atrMult = input.float(2.0, "Stop: ATR multiple", minval=0.1, step=0.5)
tgtR = input.float(2.0, "Target in R", minval=0.5, step=0.5)
hh = ta.highest(high, n)[1]
avgV = ta.sma(volume, 20)[1]
a14 = ta.sma(ta.tr(true), 14)
sig = close > hh and volume >= vmult * avgV
plot(hh, "N-day high", color.new(color.blue, 30), 1)
if sig
    stp = close - atrMult * a14
    tgt = close + tgtR * (close - stp)
    label.new(bar_index, low, "breakout setup\nclose " + str.tostring(close, format.mintick) + "\nstop " + str.tostring(stp, format.mintick) + "\ntarget " + str.tostring(tgt, format.mintick), style=label.style_label_up, color=color.new(color.teal, 10), textcolor=color.white, size=size.small)
alertcondition(sig, "Swing breakout setup", "Swing breakout rule output on the chart")

// ---- disclaimer on the chart ----
var table disc = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(disc, 0, 0, "Educational only, not investment advice", text_color=color.gray, text_size=size.small)
