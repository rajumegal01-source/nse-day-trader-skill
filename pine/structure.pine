//@version=5
// Market structure BOS / CHoCH
// Generated by lab/pine.py from the Trading Lab (github.com/rajumegal01-source/nse-day-trader-skill).
// Input defaults: the lab's general defaults.
// Educational only, not investment advice. શૈક્ષણિક હેતુ માટે, રોકાણ સલાહ નથી.
// It draws levels and raises alerts. It places no orders. No setup here has a proven edge out of sample.
indicator("Lab Market structure BOS / CHoCH", overlay=true, max_labels_count=200, max_boxes_count=100)

// ---- shared rules (same names as lab/core.py EXITS) ----
tz = "Asia/Kolkata"
deadHHMM = input.int(1130, "No new signals after (HHMM, IST)")
sideIn = input.string("both", "Sides", options=["long", "both"])
stopMode = input.string("natural", "Stop", options=["natural", "p0.5", "p1.0"])
tgtR = input.float(2.0, "Target in R (0 = exit at 15:15)", minval=0, step=0.5)
mins = hour(time, tz) * 60 + minute(time, tz)
deadMin = math.floor(deadHHMM / 100) * 60 + deadHHMM % 100
newDay = ta.change(time("D")) != 0
canSignal = mins <= deadMin and mins < 915
var bool doneToday = false
if newDay
    doneToday := false

// draws one setup label with entry / stop / target, the way lab/core.py stop_price() works
f_setup(bool isLong, float entry, float natStop, string name) =>
    float stp = stopMode == "p0.5" ? entry * (isLong ? 0.995 : 1.005) : stopMode == "p1.0" ? entry * (isLong ? 0.99 : 1.01) : natStop
    float tgt = tgtR > 0 ? entry + (isLong ? 1 : -1) * math.abs(entry - stp) * tgtR : na
    string txt = name + (isLong ? " long setup" : " short setup") + "\nentry " + str.tostring(entry, format.mintick) + "\nstop " + str.tostring(stp, format.mintick) + (na(tgt) ? "\ntarget: 15:15 exit" : "\ntarget " + str.tostring(tgt, format.mintick))
    label.new(bar_index, isLong ? low : high, txt, style=isLong ? label.style_label_up : label.style_label_down, color=isLong ? color.new(color.teal, 10) : color.new(color.maroon, 10), textcolor=color.white, size=size.small)

// ---- Market structure: BOS and CHoCH ----
// Swing high / low = a pivot with L bars on each side (known L bars later, so no repainting after
// confirmation). A close above the last unbroken swing high is a BOS when the trend was already up,
// a CHoCH (change of character) when it was down or unknown. Mirror for swing lows.
// Natural stop = the opposite swing.
L = input.int(3, "Pivot length (bars each side)", minval=1)
eventIn = input.string("both", "Setup on", options=["bos", "choch", "both"])
showAll = input.bool(true, "Label every BOS / CHoCH")
ph = ta.pivothigh(high, L, L)
pl = ta.pivotlow(low, L, L)
var float swH = na
var float swL = na
var bool hBroken = true
var bool lBroken = true
var int trend = 0
if not na(ph)
    swH := ph
    hBroken := false
if not na(pl)
    swL := pl
    lBroken := false
plot(hBroken ? na : swH, "Swing high", color.new(color.gray, 30), 1, plot.style_linebr)
plot(lBroken ? na : swL, "Swing low", color.new(color.gray, 30), 1, plot.style_linebr)
bool upEvt = false
bool dnEvt = false
string upKind = ""
string dnKind = ""
if not hBroken and close > swH
    upKind := trend == 1 ? "bos" : "choch"
    upEvt := true
    hBroken := true
    trend := 1
if not lBroken and close < swL
    dnKind := trend == -1 ? "bos" : "choch"
    dnEvt := true
    lBroken := true
    trend := -1
if showAll and upEvt
    label.new(bar_index, high, str.upper(upKind), style=label.style_label_down, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)
if showAll and dnEvt
    label.new(bar_index, low, str.upper(dnKind), style=label.style_label_up, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)
longSig = upEvt and (eventIn == "both" or eventIn == upKind) and canSignal and not doneToday and not na(swL)
shortSig = dnEvt and (eventIn == "both" or eventIn == dnKind) and canSignal and not doneToday and sideIn == "both" and not na(swH)
if longSig
    f_setup(true, close, swL, str.upper(upKind))
    doneToday := true
else if shortSig
    f_setup(false, close, swH, str.upper(dnKind))
    doneToday := true
alertcondition(upEvt or dnEvt, "BOS / CHoCH", "Structure event on the chart")

// ---- disclaimer on the chart ----
var table disc = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(disc, 0, 0, "Educational only, not investment advice", text_color=color.gray, text_size=size.small)
